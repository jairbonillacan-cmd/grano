# Ruta opcional al ejecutable de Antigravity (agy).
# Si no se define, Grano lo busca automáticamente en PATH y en %LOCALAPPDATA%\agy\bin\agy.exe.
# GRANO_AGY_PATH=C:\Users\<tu-usuario>\AppData\Local\agy\bin\agy.exe

# Modelo rápido por defecto para el tutor y explicaciones de sección.
GRANO_AI_MODEL_FAST=gemini-3.8-flash-low

# Modelo profundo por defecto para revisiones complejas y simulacros.
GRANO_AI_MODEL_DEEP=gemini-4-argon-medium

# Puerto del servidor local de producción (`npm start`). Escucha siempre en 127.0.0.1.
PORT=4173
