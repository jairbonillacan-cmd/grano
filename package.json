{
  "name": "grano",
  "private": true,
  "version": "1.0.0",
  "description": "Grano, escuela de datos: ingeniería de datos, análisis de datos y BI, de cero a experto.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "start": "vite build && node server/index.js",
    "ai:check": "node server/ai/check.js",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:sql": "node scripts/check-sql.mjs",
    "check": "npm run check:catalog && npm run check:content && npm run check:copy && npm run check:contrast && npm run check:sql",
    "shots": "node scripts/shots.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@duckdb/node-api": "^2.0.0-r.1",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-fsrs": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  }
}
